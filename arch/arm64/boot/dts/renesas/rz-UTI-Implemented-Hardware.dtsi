	gpio_keys_polled { //this is for input GPIOs only
		compatible = "gpio-keys-polled";
		#address-cells = <1>;
		#size-cells = <0>;
		poll-interval = <1>; //milliseconds
		autorepeat;	
		
		HookSwitch {
			label = "Handset Offhook";
			linux,code = <0x07>;
			//wakeup-source;
            		//interrupt-parent = <&intc_ex>;
            		gpios = <&pinctrl RZG2L_GPIO(3, 1) (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
            		//irq-gpios = <&pinctrl RZG2L_GPIO(3, 1) (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            		//interrupts = <7 IRQ_TYPE_EDGE_BOTH>;
            		linux,input-type = <5>; //EV_SW
			debounce-interval = <10>; 
		};	
		
		RingDetect {
			label = "RingDetect"; 
			linux,code = <0x08>;
			//wakeup-source;
            		//interrupt-parent = <&intc_ex>;
            		gpios = <&pinctrl RZG2L_GPIO(2, 1) GPIO_ACTIVE_LOW>;
            		//irq-gpios = <&pinctrl RZG2L_GPIO(2, 1) GPIO_ACTIVE_LOW>;
            		//interrupts = <5 IRQ_TYPE_EDGE_BOTH>;
            		linux,input-type = <5>; //EV_SW
			debounce-interval = <1>;
		};
		
		LineInUse {
			label = "LineInUse"; 
			//linux,code = <0x90>;
			linux,code = <0x09>;
			//debounce-interval = <1>;
			linux,input-type = <5>; //EV_SW
			gpios = <&pinctrl RZG2L_GPIO(48, 4) GPIO_ACTIVE_HIGH>;
		};
		
		LoopDetect {
			label = "LoopDetect"; 
			//linux,code = <0x92>;
			linux,code = <0x0A>;
			//debounce-interval = <1>;
			linux,input-type = <5>; //EV_SW
			gpios = <&pinctrl RZG2L_GPIO(48, 2) GPIO_ACTIVE_HIGH>;
		};
	};
		
