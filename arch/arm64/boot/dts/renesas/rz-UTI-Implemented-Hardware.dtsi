#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rzg2l-pinctrl.h>


/ {
	aliases {
		serial0 = &scif0;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c3 = &i2c3;
		mmc0 = &sdhi0;
		mmc1 = &sdhi1;
		dsi0 = &dsi0;
		du = &du;
		reg_1p8v = &reg_1p8v;
		reg_3p3v = &reg_3p3v;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
	
	reg_sdhi1_vmmc: regulator-sdhi1 {
		compatible = "regulator-fixed";
		regulator-name = "WLAN_EN";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		//gpio = <&pinctrl RZG2L_GPIO(46, 0) GPIO_ACTIVE_HIGH>; // WiFi Wake 
		//enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};	
	
	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		reset-gpios = <&pinctrl RZG2L_GPIO(46, 1) GPIO_ACTIVE_LOW>; // WiFi reset 
		post-power-on-delay-ms = <200>;
	};
	
	bt_sco_codec: bt_sco_codec {
		#sound-dai-cells = <1>;
		compatible = "linux,bt-sco";
	};
	
	sound-bt-sco {
		compatible = "simple-audio-card";
		simple-audio-card,name = "bt-sco-audio";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-inversion;
		simple-audio-card,frame-master = <&btcpu>;
		simple-audio-card,bitclock-master = <&btcpu>;

		btcpu: simple-audio-card,cpu {
			sound-dai = <&ssi1>;
			dai-tdm-slot-num = <2>;
			dai-tdm-slot-width = <16>;
			system-clock-frequency = <12288000>;
		};

		simple-audio-card,codec {
			sound-dai = <&bt_sco_codec 1>;
			system-clock-frequency = <12288000>;
		};
	};
	
	x1_clk: x1-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};
	
	/*lcd_bl: backlight {
		compatible = "gpio-backlight";
		gpios = <&pinctrl RZG2L_GPIO(9, 0) GPIO_ACTIVE_HIGH>;
		default-on;
	};*/
	
        lcd_bl: backlight {
		compatible = "pwm-backlight";
		pwms = <&mtu3 0 1200>;
		brightness-levels = <0 50 70 90 110 130 150 170 190 210 255>;
		default-brightness-level = <10>;
		power-supply = <&reg_3p3v>;
	};

